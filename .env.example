# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# .env is git-ignored. The agent loads it itself at startup (python-dotenv),
# so it works the same from VS Code or a terminal. Variables already set in
# the environment take precedence over this file. Use plain KEY=value lines:
# no "export", no spaces around "=".

# Required. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Jira MCP server. Without these the agent prints a warning and runs
# with only the Azure Advisor MCP server. Set JIRA_URL plus either
# JIRA_USERNAME + JIRA_API_TOKEN (Jira Cloud) or JIRA_PERSONAL_TOKEN
# (Jira Server/Data Center).
# JIRA_URL=https://your-site.atlassian.net
# JIRA_USERNAME=you@example.com
# JIRA_API_TOKEN=
# JIRA_PERSONAL_TOKEN=
